[Unit]
Description=Concorde owner interaction capability
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/concorde-owner-app
EnvironmentFile=%h/.config/concorde/owner.env
ExecStart=%h/.local/share/concorde-owner-venv/bin/python -m capabilities.owner.serve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/share/concorde-owner
LimitCORE=0

[Install]
WantedBy=default.target
