ARG COMPILER_IMAGE
ARG RUNTIME_IMAGE
FROM ${COMPILER_IMAGE} AS compiler
FROM ${RUNTIME_IMAGE}
COPY --from=compiler /usr/local/go /usr/local/go
USER root
RUN ln -s /usr/local/go/bin/go /usr/local/bin/go && ln -s /usr/local/go/bin/gofmt /usr/local/bin/gofmt
USER node
ENV PATH="/usr/local/go/bin:${PATH}" GOTOOLCHAIN=local GOPROXY=off GOSUMDB=off CGO_ENABLED=0 GOCACHE=/tmp/go-cache GOPATH=/tmp/go GOFLAGS=-buildvcs=false
WORKDIR /candidate
